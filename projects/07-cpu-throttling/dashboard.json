          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "orders-api p95 latency (correlation)",
      "description": "When orders-api is throttled its latency climbs - the classic hidden cause of 'slow for no reason'.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"orders-api\",route!=\"/healthz\"}[$__rate_interval])))",
          "legendFormat": "p95 orders-api"
        }
      ],
      "fieldConfig": {
        "defaults": {
