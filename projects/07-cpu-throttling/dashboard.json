        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(container_spec_cpu_quota{name=\"lab-orders-api\"}) / sum(container_spec_cpu_period{name=\"lab-orders-api\"})",
