    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Message Queue: Kafka Consumer Lag\nStart with `make mq-on`. Lag = messages produced but not yet processed. Growing lag = consumers can't keep up; your 'async' work is getting late.\n\n\ud83d\udcd6 Full guide: `projects/14-message-queue-lag/README.md`"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Firing alerts (this project)",
      "description": "Prometheus alerts from this project's alerts.yml that are firing right now.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", project=\"14\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "id": 2,
