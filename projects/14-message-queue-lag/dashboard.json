    {
      "type": "stat",
      "title": "Estimated time to drain",
      "description": "lag \u00f7 consumption rate. How long until consumers catch up if producers stopped.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_consumergroup_lag_sum) / sum(rate(kafka_consumergroup_current_offset_sum[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
