        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(service:sli_errors:ratio_rate5m, service)",
          "refId": "v"
        },
        "definition": "label_values(service:sli_errors:ratio_rate5m, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
