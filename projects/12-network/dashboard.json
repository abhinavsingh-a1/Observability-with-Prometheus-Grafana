  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Network Throughput, Errors & TCP\nBandwidth, packet errors/drops, TCP health and per-container traffic. Network problems often show up first as retransmits and latency.\n\n\ud83d\udcd6 Full guide: `projects/12-network/README.md`"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Firing alerts (this project)",
      "description": "Prometheus alerts from this project's alerts.yml that are firing right now.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", project=\"12\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 18,
        "y": 0,
