    {
      "type": "stat",
      "title": "Payment failures / min",
      "description": "Business errors: the HTTP call worked but the payment did not.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(payments_failed_total{service=~\"$service\"}[5m])) * 60",
