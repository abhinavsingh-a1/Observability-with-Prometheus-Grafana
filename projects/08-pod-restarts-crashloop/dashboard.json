    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Pod Restarts, CrashLoopBackOff & OOMKilled (Kubernetes)\nKubernetes track - needs the kind cluster from `k8s/README.md`. Unstable pods: why they restart and how often.\n\n\ud83d\udcd6 Full guide: `projects/08-pod-restarts-crashloop/README.md`"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Firing alerts (this project)",
      "description": "Prometheus alerts from this project's alerts.yml that are firing right now.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", project=\"08\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
