        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "Concurrency. Rising in-flight + rising latency = saturation (Little's law).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (http_requests_in_flight{service=~\"$service\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
