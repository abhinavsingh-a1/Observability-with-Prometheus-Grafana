        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Apdex (T=250ms)",
      "description": "Satisfied (<250ms) + half of Tolerating (<1s) / total. 1.0 = perfect.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_request_duration_seconds_bucket{service=~\"$service\",route!=\"/healthz\",le=\"0.25\"}[5m])) + sum(rate(http_request_duration_seconds_bucket{service=~\"$service\",route!=\"/healthz\",le=~\"1(\\\\.0)?\"}[5m]))) / 2 / sum(rate(http_request_duration_seconds_count{service=~\"$service\",route!=\"/healthz\"}[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
