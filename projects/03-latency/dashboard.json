          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{service=~\"$service\",route!=\"/healthz\"}[5m])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
