    {
      "type": "stat",
      "title": "Average",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_sum{service=~\"$service\",route!=\"/healthz\"}[5m])) / sum(rate(http_request_duration_seconds_count{service=~\"$service\",route!=\"/healthz\"}[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
